    {
      "parameters": {
        "jsCode": "const digits = s => String(s || '').replace(/\\D/g, '');\nconst phone = digits($('Webhook').first().json.body.caller_phone);\nconst rows = $input.all().map(i => i.json);\nconst oneHour = 60 * 60 * 1000;\n\nconst isDuplicate = rows.some(r =>\n  digits(r.caller_phone) === phone &&\n  r.status === 'sent' &&\n  Date.now() - new Date(r.logged_at).getTime() < oneHour\n);\n\nreturn [{ json: { isDuplicate } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -2528,
        592
      ],
      "id": "6ee67594-a292-4f19-9907-8ae6317305ad",
